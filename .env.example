# ─────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Anything prefixed NEXT_PUBLIC_ is exposed to the browser — that's fine for
# public keys and project URLs. NEVER put secret keys here; those go in
# Supabase secrets (see README → "The funnel backend").
# ─────────────────────────────────────────────────────────────────────────

# Supabase — project URL and the PUBLIC (anon) key. Both are safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack — your PUBLIC key only (pk_live_… once you go live, pk_test_… to test).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# The paid offer the popup charges for.
# Amount is in the smallest unit: kobo for NGN (₦50,000 = 5000000).
NEXT_PUBLIC_OFFER_AMOUNT_KOBO=5000000
NEXT_PUBLIC_OFFER_CURRENCY=NGN
NEXT_PUBLIC_OFFER_LABEL=Growth System Build — Deposit
