# ─────────────────────────────────────────────────────────────────────────
# SYNERGOX — environment variables
#
# Set these in Vercel → Project → Settings → Environment Variables, then
# REDEPLOY. Full walkthrough: SETUP.txt.
#
# Two kinds:
#   NEXT_PUBLIC_*  are sent to the browser. Public values only.
#   everything else stays on the server and is never sent to the browser.
# ─────────────────────────────────────────────────────────────────────────

# The live address, no trailing slash. Used in emails, the sitemap and
# Paystack's return link.
NEXT_PUBLIC_SITE_URL=https://synergox.co

# Supabase project URL + PUBLIC (anon) key. Both are browser-safe and have
# working defaults in lib/site.ts; set them only to point at another project.
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Server secrets ───────────────────────────────────────────────────────

# Supabase → Project Settings → API → service_role key.
# Lets the server mark orders paid and run the email sequence.
SUPABASE_SERVICE_ROLE_KEY=

# Paystack → Settings → API Keys & Webhooks → Secret key.
# sk_test_… to rehearse, sk_live_… to take real money.
PAYSTACK_SECRET_KEY=

# Resend → API Keys. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=SYNERGOX <hello@synergox.co>
# Optional: where replies to funnel emails go (defaults to EMAIL_FROM).
# EMAIL_REPLY_TO=hello@synergox.co
# Optional: where "new order" / "brief received" notices go
# (defaults to the contact email set in the dashboard).
# ORDER_NOTIFY_EMAIL=

# Any long random string. Vercel Cron sends it to run the daily email send.
CRON_SECRET=

# Optional: a Calendly personal access token, so booked call times fill in
# automatically on the Consultations screen.
# CALENDLY_API_TOKEN=
