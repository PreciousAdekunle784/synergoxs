# ─────────────────────────────────────────────────────────────────────────
# You do NOT need this file if you paste your keys directly into lib/site.ts
# (simplest — see PAYSTACK_FIX.txt). This is only for those who prefer env
# vars. Anything NEXT_PUBLIC_ is exposed to the browser (fine for public keys)
# and is baked in at BUILD time — so REDEPLOY after changing any of them.
# Secret keys never go here; they go in Supabase secrets.
# ─────────────────────────────────────────────────────────────────────────

# Supabase — project URL + PUBLIC (anon) key. Both safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Paystack — your PUBLIC key only (pk_live_… live, pk_test_… to test).
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxx

# The paid offer. Amount in the smallest unit: kobo for NGN (₦199,999 = 19999900).
NEXT_PUBLIC_OFFER_AMOUNT_KOBO=19999900
NEXT_PUBLIC_OFFER_CURRENCY=NGN
NEXT_PUBLIC_OFFER_LABEL=Growth System Build
